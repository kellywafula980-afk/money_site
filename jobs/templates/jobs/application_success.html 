<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Submitted | GlobalGigs</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white">
    <div class="max-w-2xl mx-auto px-4 py-20 text-center">
        <div class="bg-zinc-900/60 border border-emerald-500/30 rounded-2xl p-8">
            <div class="text-6xl mb-4">✅</div>
            <h1 class="text-2xl font-bold mb-2">Application Submitted Successfully!</h1>
            <p class="text-zinc-400 mb-4">Thank you for applying to <strong>{{ job.title }}</strong> at {{ job.company_name }}</p>
            <p class="text-zinc-500 mb-6">The employer will review your application and contact you if there's a match.</p>
            <a href="/" class="inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-black font-bold rounded-xl transition">
                Browse More Jobs
            </a>
        </div>
    </div>
</body>
</html>